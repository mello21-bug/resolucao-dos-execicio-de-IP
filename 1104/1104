#include <stdio.h>

int main() {
    int a[10], b[10], c[10];

    // lê o primeiro vetor
    for (int i = 0; i < 10; i++) {
        scanf("%d", &a[i]);
    }

    // lê o segundo vetor
    for (int i = 0; i < 10; i++) {
        scanf("%d", &b[i]);
    }

    // soma os vetores
    for (int i = 0; i < 10; i++) {
        c[i] = a[i] + b[i];
    }

    // imprime o vetor resultante
    for (int i = 0; i < 10; i++) {
        printf("%d ", c[i]);
    }

    return 0;
}
